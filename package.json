    "firebase-admin": "^13.7.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.11.0",
    "mongodb": "^5.7.0",
    "mongoose": "^9.11.2",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
