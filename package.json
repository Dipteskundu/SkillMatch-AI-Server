  "description": "JobMatch AI / SkillMatch backend — Express + MongoDB (raw driver) + Mongoose schema layer",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "check": "node --check index.js",
