# Get these from the Firebase console → Project settings → Your apps → Web app
# FIREBASE_API_KEY is the web API key (NEXT_PUBLIC_FIREBASE_API_KEY)
# FIREBASE_WEB_CLIENT_ID is the web app client ID (NEXT_PUBLIC_FIREBASE_APP_ID)
FIREBASE_API_KEY=
FIREBASE_WEB_CLIENT_ID=
