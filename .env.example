# ## Backend (Express on Vercel Serverless)

# # Mongo
# MONGODB_URI=
# MONGO_DB_NAME=

# # AI
# GEMINI_API_KEY=
# # Optional: override the model fallback chain (comma-separated, ordered).
# # Default: gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_MODELS=

# # Fallback provider (OpenRouter) — used automatically when Gemini fails
# # (invalid key, quota, 5xx, network). Leave unset to disable the fallback.
# # NEVER commit a real key.
# FALLBACK_API_KEY_OPEN_ROUTER=
# # Optional: ordered OpenRouter model chain (comma-separated). Free models.
# # Default: nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,minimax/minimax-m3.1-flash:free,poolside/laguna-s-2.1:free
# OPENROUTER_MODELS=
# # Optional: OpenRouter `reasoning` effort for free reasoning models.
# # Default: none (they otherwise burn max_tokens on CoT and return EMPTY content).
# # Set to "" to omit the reasoning field entirely, or minimal/low/medium/high to
# # keep some reasoning. A 400 mentioning "reasoning" retries the model once without the field.
# OPENROUTER_REASONING_EFFORT=none
# # Optional: provider mode.
# #   auto       Gemini first, OpenRouter fallback on failure (default)
# #   gemini     Gemini only (legacy behaviour)
# #   openrouter OpenRouter only (debugging the fallback provider)
# LLM_PROVIDER=auto
# # Optional: how long to skip Gemini after a provider-level failure (ms),
# # then Gemini is retried first again. Default: 600000 (10 minutes)
# GEMINI_COOLDOWN_MS=600000

# # Firebase Admin (optional, for protected routes + realtime notifications)
# # Recommended on Vercel: paste the full service account JSON (or base64-encoded JSON) here.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# # Local dev only alternative: point to a JSON file (do NOT use this on Vercel)
# FIREBASE_SERVICE_ACCOUNT_PATH=jobmatching-firebase-adminsdk-.json
# # Alternatively (if you prefer splitting fields):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# # Optional (will be derived from project id if omitted)
# FIREBASE_DATABASE_URL=

# # CORS (comma-separated). Example: https://your-frontend.vercel.app,http://localhost:3000
# CORS_ORIGIN=

# # Background job queue (async resume pipeline — in-process, no Redis)
# # Max in-process worker jobs running at once (default: 2)
# WORKER_CONCURRENCY=2
# # Retry backoff between job attempts in ms (default: 250)
# QUEUE_BACKOFF_MS=250
# # Age after which queued/running jobs from a dead process are recovered (minutes, default: 30)
# QUEUE_STALE_MINUTES=30

# # Local dev only
# PORT=5000

# # SkillForge Learning Hub entitlements (Phase 4) — Free tier limits.
# # Free learners: lesson views per calendar day (default 3).
# FREE_DAILY_LESSONS=3
# # Free learners: active (not-completed) learning paths at a time (default 1).
# FREE_ACTIVE_PATHS=1
